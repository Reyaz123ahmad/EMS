PORT=5000
FRONTEND_URL=http://localhost:3000
DATABASE_URL=postgresql://user:password@localhost:5432/ems_db?schema=public
JWT_ACCESS_SECRET=your_jwt_access_secret_key
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key
JWT_ACCESS_EXPIRES_IN=20h
JWT_REFRESH_EXPIRES_IN_DAYS=30
JWT_ISSUER=mindstocs_ems
JWT_AUDIENCE=mindstocs_ems-api
BCRYPT_ROUNDS=12
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=SuperAdminPassword@123
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@mindstocs.com
SMTP_FROM_NAME=EMS System
REDIS_URL=redis://127.0.0.1:6379
NODE_ENV=development
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
AADHAAR_PROVIDER_URL=
AADHAAR_API_KEY=
SMS_PROVIDER=
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=
PUSH_PROVIDER=
PUSH_API_URL=
PUSH_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ==============================================================================
# AI & MACHINE LEARNING CONFIGURATION (GOOGLE GEMINI FREE TIER + GROQ FALLBACK)
# ==============================================================================
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-1.5-flash
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.7
AI_CACHE_TTL_HOURS=24
AI_RATE_LIMIT_PER_MINUTE=15
AI_RATE_LIMIT_PER_DAY=1500
GROQ_API_KEY=your_optional_groq_fallback_api_key_here
