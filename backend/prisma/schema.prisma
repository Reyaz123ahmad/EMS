generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ 1. PLATFORM LEVEL (5 models) ============

model SubscriptionPlan {
  id            String         @id @default(uuid())
  name          String         @unique
  description   String?
  price         Decimal        @db.Decimal(10, 2)
  billingCycle  String         @default("monthly")
  features      Json // { attendance: { face: true, card: false }, payroll: true, ... }
  maxEmployees  Int            @default(50) // -1 = unlimited
  maxBranches   Int            @default(1)
  maxDevices    Int            @default(1)
  maxStorageGB  Int            @default(5)
  securityLevel String         @default("basic") // basic, standard, high
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Company {
  id             String        @id @default(uuid())
  name           String
  domain         String?       @unique
  email          String?
  phone          String?
  address        String?
  logoUrl        String?
  companyCode    String?       @unique
  subscription   Subscription?

  // STRUCTURED SETTINGS (JSON)
  attendanceSettings   Json @default("{}")
  securitySettings     Json @default("{}")
  leaveSettings        Json @default("{}")
  payrollSettings      Json @default("{}")
  notificationSettings Json @default("{}")
  generalSettings      Json @default("{}")

  // PAYROLL & STATUTORY CONFIGURATION
  payrollCycleStartDay   Int      @default(1)
  payrollCycleEndDay     Int      @default(0)   // 0 = last day
  payrollRunDay          Int      @default(1)
  payrollRunTime         String   @default("00:05")
  payrollAutoRunEnabled  Boolean  @default(false)
  overtimeRate           Decimal? @default(0) @db.Decimal(10, 2)
  lopDivisor             Int      @default(30)  // 30 or 26
  lateMarksForHalfDay    Int      @default(3)
  roundOffRule           String   @default("NEAREST_RUPEE")
  pfEnabled              Boolean  @default(true)
  pfEmployeePercent      Decimal? @default(12.00) @db.Decimal(5, 2)
  pfEmployerPercent      Decimal? @default(12.00) @db.Decimal(5, 2)
  pfCeiling              Decimal? @default(15000.00) @db.Decimal(12, 2)
  esiEnabled             Boolean  @default(true)
  esiEmployeePercent     Decimal? @default(0.75) @db.Decimal(5, 2)
  esiEmployerPercent     Decimal? @default(3.25) @db.Decimal(5, 2)
  esiCeiling             Decimal? @default(21000.00) @db.Decimal(12, 2)
  ptState                String?  @default("MAHARASHTRA")
  tdsEnabled             Boolean  @default(true)

  status    CompanyStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  branches         Branch[]
  departments      Department[]
  designations     Designation[]
  employees        Employee[]
  users            User[]
  roles            Role[]
  biometricDevices BiometricDevice[]
  biometricCards   EmployeeCard[]
  holidayCalendars HolidayCalendar[]
  weeklyOffRules   WeeklyOffRule[]
  shifts           Shift[]
  breakRules       BreakRule[]
  overtimeRules    OvertimeRule[]
  salaryComponents SalaryComponent[]
  assets           Asset[]
  clients          Client[]
  projects         Project[]
  payrollRuns      PayrollRun[]
  attendanceLogs   AttendanceLog[]
  devicePunches    DevicePunch[]
  reportHistories  ReportHistory[]
  loans            Loan[]
  reimbursements   Reimbursement[]

  @@map("companies")
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  EXPIRED
}

model Subscription {
  id          String             @id @default(uuid())
  companyId   String             @unique
  company     Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  planId      String
  plan        SubscriptionPlan   @relation(fields: [planId], references: [id])
  status      SubscriptionStatus @default(ACTIVE)
  startDate   DateTime           @default(now())
  endDate     DateTime?
  trialEndsAt DateTime?
  autoRenew   Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  payments    PaymentTransaction[]
  invoices    Invoice[]

  @@map("subscriptions")
}

enum SubscriptionStatus {
  ACTIVE
  TRIAL
  EXPIRED
  CANCELLED
  PAST_DUE
}

model PaymentTransaction {
  id                String        @id @default(uuid())
  subscriptionId    String
  subscription      Subscription  @relation(fields: [subscriptionId], references: [id])
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("INR")
  status            PaymentStatus @default(PENDING)
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?
  metadata          Json?
  createdAt         DateTime      @default(now())
  refundRequests    RefundRequest[]

  @@map("payment_transactions")
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model RefundRequest {
  id               String        @id @default(uuid())
  paymentId        String
  payment          PaymentTransaction @relation(fields: [paymentId], references: [id])
  companyId        String
  requestedBy      String
  amount           Decimal       @db.Decimal(10, 2)
  reason           String
  refundType       String        // CUSTOMER_REQUEST, SYSTEM_ISSUE, ADMIN_INITIATED, DUPLICATE_PAYMENT
  description      String?
  status           RefundStatus  @default(PENDING)
  razorpayRefundId String?
  processedBy      String?
  processedAt      DateTime?
  rejectionReason  String?
  adminNotes       String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([companyId, status])
  @@index([paymentId])
  @@map("refund_requests")
}

enum RefundStatus {
  PENDING
  APPROVED
  PROCESSED
  REJECTED
  FAILED
}

model Coupon {
  id            String    @id @default(uuid())
  code          String    @unique
  discountType  String    // PERCENTAGE, FIXED
  discountValue Decimal   @db.Decimal(10, 2)
  validFrom     DateTime  @default(now())
  validTo       DateTime
  maxUses       Int       @default(100)
  usedCount     Int       @default(0)
  planIds       Json?     // string[] of eligible plan IDs, null = all
  isActive      Boolean   @default(true)
  createdBy     String?
  companyId     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("coupons")
}

model Invoice {
  id             String        @id @default(uuid())
  subscriptionId String
  subscription   Subscription  @relation(fields: [subscriptionId], references: [id])
  invoiceNumber  String        @unique
  amount         Decimal       @db.Decimal(10, 2)
  tax            Decimal       @default(0) @db.Decimal(10, 2)
  total          Decimal       @db.Decimal(10, 2)
  status         InvoiceStatus @default(UNPAID)
  dueDate        DateTime
  paidAt         DateTime?
  pdfUrl         String?
  createdAt      DateTime      @default(now())

  @@map("invoices")
}

enum InvoiceStatus {
  UNPAID
  PAID
  OVERDUE
  CANCELLED
}

// ============ 2. AUTH & ACCESS (8 models) ============

model User {
  id               String          @id @default(uuid())
  companyId        String?
  company          Company?        @relation(fields: [companyId], references: [id])
  email            String          @unique
  phone            String?
  passwordHash     String
  twoFactorEnabled Boolean         @default(false)
  twoFactorSecret  String?
  status           UserStatus      @default(ACTIVE)
  lastLoginAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  userRoles        UserRole[]
  sessions         Session[]
  loginLogs        LoginLog[]
  auditLogs        AuditLog[]
  employee         Employee?
  client           Client?
  notifications    Notification[]
  securityEvents   SecurityEvent[]

  @@index([companyId, status])
  @@index([email])
  @@map("users")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
  SUSPENDED
}

model Role {
  id              String           @id @default(uuid())
  companyId       String?
  company         Company?         @relation(fields: [companyId], references: [id])
  name            String // SUPER_ADMIN, COMPANY_ADMIN, HR_ADMIN, HR_MANAGER, MANAGER, EMPLOYEE, CLIENT
  displayName     String
  description     String?
  isSystem        Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([companyId, name])
  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid())
  key             String           @unique
  description     String?
  category        String?
  createdAt       DateTime         @default(now())
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId     String
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@unique([userId, roleId])
  @@map("user_roles")
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String   @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

model LoginLog {
  id            String   @id @default(uuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  email         String
  ipAddress     String?
  userAgent     String?
  status        String
  failureReason String?
  createdAt     DateTime @default(now())

  @@map("login_logs")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  oldValues Json?
  newValues Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}

model SecurityEvent {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  companyId   String?
  eventType   String
  severity    String
  description String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@map("security_events")
}

// ============ 3. ORGANIZATION (3 models) ============

model Branch {
  id               String            @id @default(uuid())
  companyId        String
  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name             String
  code             String?
  branchCode       String?
  address          String?
  city             String?
  state            String?
  country          String            @default("India")
  pincode          String?
  latitude         Decimal?          @db.Decimal(10, 8)
  longitude        Decimal?          @db.Decimal(11, 8)
  geofenceRadius   Int               @default(100)
  isGeofenceActive Boolean           @default(true)
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  employees        Employee[]
  biometricDevices BiometricDevice[]

  @@unique([companyId, code])
  @@unique([companyId, branchCode])
  @@map("branches")
}

model Department {
  id          String       @id @default(uuid())
  companyId   String
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name           String
  code           String?
  departmentCode String?
  description    String?
  parentId       String?
  parent         Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children       Department[] @relation("DepartmentHierarchy")
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  employees      Employee[]

  @@unique([companyId, name])
  @@unique([companyId, departmentCode])
  @@map("departments")
}

model Designation {
  id          String     @id @default(uuid())
  companyId   String
  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name            String
  code            String?
  designationCode String?
  level           Int?
  description     String?
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  employees       Employee[]

  @@unique([companyId, name])
  @@unique([companyId, designationCode])
  @@map("designations")
}

// ============ 4. EMPLOYEE (1 model) ============

model Employee {
  id                    String                    @id @default(uuid())
  companyId             String
  company               Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId                String?                   @unique
  user                  User?                     @relation(fields: [userId], references: [id])
  employeeCode          String
  firstName             String
  lastName              String
  email                 String?
  phone                 String?
  dateOfBirth           DateTime?
  gender                String?
  branchId              String?
  branch                Branch?                   @relation(fields: [branchId], references: [id])
  departmentId          String?
  department            Department?               @relation(fields: [departmentId], references: [id])
  designationId         String?
  designation           Designation?              @relation(fields: [designationId], references: [id])
  managerId             String?
  manager               Employee?                 @relation("EmployeeManager", fields: [managerId], references: [id])
  subordinates          Employee[]                @relation("EmployeeManager")
  joiningDate           DateTime
  employmentType        EmploymentType            @default(FULL_TIME)
  status                EmployeeStatus            @default(ACTIVE)
  photoUrl              String?
  photoPublicId         String?
  faceEmbedding         String?
  facePhotoUrl          String?
  facePhotoPublicId     String?
  faceRegisteredAt      DateTime?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  attendanceLogs        AttendanceLog[]
  attendanceBreaks      AttendanceBreak[]
  leaveBalances         LeaveBalance[]
  leaveRequests         LeaveRequest[]
  overtimeRecords       OvertimeRecord[]
  overtimeRequests      OvertimeRequest[]
  employeeCards         EmployeeCard[]
  devicePunches         DevicePunch[]
  employeeDevices       EmployeeDevice[]
  documents             EmployeeDocument[]
  certificates          EmployeeCertificate[]
  salaryStructure       EmployeeSalaryStructure?
  payrollItems          PayrollItem[]
  tasks                 Task[]
  projectMembers        ProjectMember[]
  emergencyRequests     EmergencyAttendance[]
  performanceReviews    PerformanceReview[]
  goals                 Goal[]
  assets                AssetAssignment[]
  shiftAssignments      ShiftAssignment[]
  rosters               Roster[]
  weeklyOffAssignments  WeeklyOffAssignment[]
  fraudSignals          FraudSignal[]
  livenessVerifications LivenessVerification[]
  faceRegistrationRequests FaceRegistrationRequest[]
  loans                 Loan[]
  reimbursements        Reimbursement[]

  @@unique([companyId, employeeCode])
  @@index([companyId, status])
  @@index([companyId, departmentId])
  @@index([companyId, branchId])
  @@index([companyId, email])
  @@index([userId])
  @@map("employees")
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
  CONSULTANT
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  TERMINATED
  RESIGNED
  ON_LEAVE
}

// ============ 5. ATTENDANCE (6 models) ============

model AttendanceLog {
  id                    String            @id @default(uuid())
  companyId             String
  company               Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId            String
  employee              Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  attendanceDate        DateTime          @db.Date
  checkInAt             DateTime?
  checkOutAt            DateTime?
  checkInPhotoUrl       String?
  checkInPhotoPublicId  String?
  checkOutPhotoUrl      String?
  checkOutPhotoPublicId String?
  attendanceMethod      String?
  faceMatchScore        String?
  livenessScore         String?
  verificationLayers    Json?
  checkInLatitude       Decimal?          @db.Decimal(10, 8)
  checkInLongitude      Decimal?          @db.Decimal(11, 8)
  checkInAccuracy       Decimal?          @db.Decimal(6, 2)
  checkInDistance       Decimal?          @db.Decimal(10, 2)
  checkInBranchId       String?
  checkOutLatitude      Decimal?          @db.Decimal(10, 8)
  checkOutLongitude     Decimal?          @db.Decimal(11, 8)
  checkOutAccuracy      Decimal?          @db.Decimal(6, 2)
  checkOutDistance      Decimal?          @db.Decimal(10, 2)
  checkOutBranchId      String?
  cardNumber            String?
  deviceId              String?
  isMockLocation        Boolean           @default(false)
  isVpnDetected         Boolean           @default(false)
  isDeviceTrusted       Boolean           @default(false)
  ipAddress             String?
  totalWorkedMinutes    Int?
  overtimeMinutes       Int?
  // Holiday
  isHoliday             Boolean           @default(false)
  holidayName           String?
  holidayType           String?

  // Shift
  shiftId               String?
  shiftName             String?
  shiftStartTime        String?
  shiftEndTime          String?
  shiftSource           String?           // 'ROSTER' | 'ASSIGNMENT' | 'EMPLOYEE_DEFAULT' | 'COMPANY_DEFAULT'
  expectedStart         DateTime?
  expectedEnd           DateTime?
  isRosterOverride      Boolean           @default(false)

  // Late
  isLate                Boolean           @default(false)
  lateMinutes           Int?              @default(0)
  earlyExitMinutes      Int?              @default(0)
  adjustedCheckOutTime  DateTime?

  // Checkout & Worked Duration
  workedMinutes         Int?
  requiredMinutes       Int?
  actualMinutes         Int?
  shortfallMinutes      Int?

  // Break
  totalBreaks           Int               @default(0)
  totalBreakMinutes     Int               @default(0)
  remainingBreaks       Int?
  remainingBreakMinutes Int?

  status                AttendanceStatus  @default(PRESENT)
  remarks               String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  breaks                AttendanceBreak[]

  @@unique([employeeId, attendanceDate])
  @@index([companyId, attendanceDate])
  @@index([companyId, attendanceDate, status])
  @@index([companyId, isLate])
  @@index([employeeId, attendanceDate])
  @@index([shiftId])
  @@map("attendance_logs")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LATE
  ON_LEAVE
  HOLIDAY
  WEEKLY_OFF
}

model AttendanceBreak {
  id                     String        @id @default(uuid())
  attendanceLogId        String
  attendanceLog          AttendanceLog @relation(fields: [attendanceLogId], references: [id], onDelete: Cascade)
  employeeId             String
  employee               Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  
  // Break Start
  breakStartAt           DateTime
  breakPhotoUrl          String?
  breakStartPhotoUrl     String?
  breakPhotoPublicId     String?
  breakLivenessScore     String?
  breakFaceMatchScore    String?
  
  // Break End
  breakEndAt             DateTime?
  breakEndPhotoUrl       String?
  breakEndPhotoPublicId  String?
  breakEndLivenessScore  String?
  breakEndFaceMatchScore String?
  
  totalBreakMinutes      Int?
  breakType              String?       // LUNCH, SHORT
  expectedReturnTime     DateTime?
  actualReturnTime       DateTime?
  lateReturnMinutes      Int           @default(0)
  allowedDurationMinutes Int?
  createdAt              DateTime      @default(now())

  @@map("attendance_breaks")
}

model LivenessChallenge {
  id            String   @id @default(uuid())
  employeeId    String
  challengeType String
  challengeData Json?
  expiresAt     DateTime
  verified      Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@map("liveness_challenges")
}

model LivenessVerification {
  id              String   @id @default(uuid())
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  livenessScore   Decimal  @db.Decimal(5, 4)
  isLive          Boolean
  challengeType   String?
  challengePassed Boolean?
  photoUrl        String?
  metadata        Json?
  createdAt       DateTime @default(now())

  @@map("liveness_verifications")
}

model FraudSignal {
  id             String    @id @default(uuid())
  companyId      String
  employeeId     String?
  employee       Employee? @relation(fields: [employeeId], references: [id])
  signalType     String
  severity       String
  description    String?
  employeeLat    Decimal?  @db.Decimal(10, 8)
  employeeLng    Decimal?  @db.Decimal(11, 8)
  expectedLat    Decimal?  @db.Decimal(10, 8)
  expectedLng    Decimal?  @db.Decimal(11, 8)
  distanceMeters Decimal?  @db.Decimal(10, 2)
  metadata       Json?
  reviewed       Boolean   @default(false)
  reviewedBy     String?
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([companyId, createdAt])
  @@map("fraud_signals")
}

// ============ 6. BIOMETRIC (5 models) ============

model BiometricDevice {
  id            String        @id @default(uuid())
  companyId     String
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId      String?
  branch        Branch?       @relation(fields: [branchId], references: [id])
  name          String
  serialNumber  String
  deviceType    DeviceType
  apiKey        String        @unique
  ipAddress     String?
  port          Int?
  lastHeartbeat DateTime?
  isActive      Boolean       @default(true)
  isOnline      Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  devicePunches DevicePunch[]

  @@unique([companyId, serialNumber])
  @@map("biometric_devices")
}

enum DeviceType {
  CARD
  FINGERPRINT
  FACE
  HYBRID
}

model EmployeeCard {
  id                 String    @id @default(uuid())
  companyId          String
  company            Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId         String
  employee           Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  cardNumber         String
  cardType           CardType  @default(QR)
  qrUrl              String?
  pdfUrl             String?
  qrSignature        String?
  regenerationCount  Int       @default(0)
  deactivationReason String?
  isActive           Boolean   @default(true)
  expiresAt          DateTime?
  assignedAt         DateTime  @default(now())
  deactivatedAt      DateTime?

  @@unique([companyId, cardNumber])
  @@index([cardNumber])
  @@map("employee_cards")
}

enum CardType {
  RFID
  NFC
  MAGNETIC
  QR
}

model DevicePunch {
  id           String          @id @default(uuid())
  companyId    String
  company      Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deviceId     String
  device       BiometricDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  employeeId   String?
  employee     Employee?       @relation(fields: [employeeId], references: [id])
  cardNumber   String?
  punchType    String
  verification String
  rawPayload   Json?
  processed    Boolean         @default(false)
  errorReason  String?
  punchedAt    DateTime
  createdAt    DateTime        @default(now())

  @@index([deviceId, punchedAt])
  @@map("device_punches")
}

model EmployeeDevice {
  id             String                @id @default(uuid())
  employeeId     String
  employee       Employee              @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  deviceId       String                @unique
  deviceName     String?
  platform       String?
  osVersion      String?
  appVersion     String?
  isTrusted      Boolean               @default(false)
  isActive       Boolean               @default(true)
  registeredAt   DateTime              @default(now())
  lastUsedAt     DateTime?
  changeRequests DeviceChangeRequest[]

  @@map("employee_devices")
}

model DeviceChangeRequest {
  id               String         @id @default(uuid())
  employeeId       String
  employeeDeviceId String
  employeeDevice   EmployeeDevice @relation(fields: [employeeDeviceId], references: [id])
  newDeviceId      String
  newDeviceName    String?
  reason           String?
  status           String         @default("PENDING")
  approvedBy       String?
  approvedAt       DateTime?
  createdAt        DateTime       @default(now())

  @@map("device_change_requests")
}

model FaceRegistrationLog {
  id            String   @id @default(uuid())
  companyId     String
  employeeId    String
  action        String   // REGISTER, UPDATE, DELETE, BULK_REGISTER
  photoUrl      String?
  livenessScore Decimal? @db.Decimal(5, 4)
  oldEmbedding  String?  // encrypted
  newEmbedding  String?  // encrypted
  registeredBy  String?
  reason        String?
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([companyId, employeeId])
  @@map("face_registration_logs")
}

model FingerEnrollment {
  id             String    @id @default(uuid())
  companyId      String
  employeeId     String
  fingerIndex    Int       // 0-9
  templateData   String    // Encrypted template (Base64)
  templateFormat String    @default("ISO") // ISO, ANSI, RAW
  deviceId       String?
  enrolledBy     String?
  isSynced       Boolean   @default(false)
  syncedAt       DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([employeeId, fingerIndex])
  @@index([companyId, employeeId])
  @@map("finger_enrollments")
}

model DeviceAttestation {
  id               String   @id @default(uuid())
  deviceId         String   @unique
  platform         String   // android, ios, web
  provider         String   @default("PLAY_INTEGRITY") // PLAY_INTEGRITY, APP_ATTEST, SAFETY_NET
  attestationToken String
  integrityLevel   String   // BASIC, STRONG, HARDWARE_BACKED, FAILED
  isRooted         Boolean  @default(false)
  isEmulator       Boolean  @default(false)
  isTampered       Boolean  @default(false)
  passed           Boolean  @default(true)
  failureReason    String?
  metadata         Json?
  lastAttestedAt   DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("device_attestations")
}

// ============ 7. LEAVE (3 models) ============

model LeaveType {
  id              String         @id @default(uuid())
  companyId       String
  name            String
  code            String?
  description     String?
  maxDaysPerYear  Int?
  isPaid          Boolean        @default(true)
  carryForward    Boolean        @default(false)
  maxCarryForward Int?
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  leaveBalances   LeaveBalance[]
  leaveRequests   LeaveRequest[]

  @@unique([companyId, name])
  @@map("leave_types")
}

model LeaveBalance {
  id            String    @id @default(uuid())
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId   String
  leaveType     LeaveType @relation(fields: [leaveTypeId], references: [id])
  year          Int
  totalDays     Decimal   @db.Decimal(5, 2)
  usedDays      Decimal   @default(0) @db.Decimal(5, 2)
  remainingDays Decimal   @db.Decimal(5, 2)
  updatedAt     DateTime  @updatedAt

  @@unique([employeeId, leaveTypeId, year])
  @@map("leave_balances")
}

model LeaveRequest {
  id              String        @id @default(uuid())
  employeeId      String
  employee        Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId     String
  leaveType       LeaveType     @relation(fields: [leaveTypeId], references: [id])
  startDate       DateTime
  endDate         DateTime
  totalDays       Decimal       @db.Decimal(5, 2)
  reason          String?
  status          RequestStatus @default(PENDING)
  approvedBy      String?
  approvedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([employeeId, status])
  @@map("leave_requests")
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// ============ 8. OVERTIME (3 models) ============

model OvertimeRule {
  id               String   @id @default(uuid())
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name             String
  multiplier       Decimal  @db.Decimal(3, 2)
  minMinutes       Int      @default(30)
  maxMinutesPerDay Int?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())

  @@map("overtime_rules")
}

model OvertimeRecord {
  id         String    @id @default(uuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime  @db.Date
  minutes    Int
  multiplier Decimal   @db.Decimal(3, 2)
  status     String    @default("PENDING")
  approvedBy String?
  approvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@map("overtime_records")
}

model OvertimeRequest {
  id               String        @id @default(uuid())
  employeeId       String
  employee         Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date             DateTime      @db.Date
  requestedMinutes Int
  reason           String?
  status           RequestStatus @default(PENDING)
  approvedBy       String?
  approvedAt       DateTime?
  createdAt        DateTime      @default(now())

  @@map("overtime_requests")
}

// ============ 9. SHIFTS & ROSTERS (7 models) ============

model Shift {
  id               String            @id @default(uuid())
  companyId        String
  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name             String
  startTime        String
  endTime          String
  graceMinutes     Int               @default(15)
  isNightShift     Boolean           @default(false)
  workingHours     Int               @default(8)
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  shiftAssignments ShiftAssignment[]
  rosters          Roster[]
  shiftBreakRules  ShiftBreakRule[]

  @@unique([companyId, name])
  @@map("shifts")
}

model ShiftAssignment {
  id            String    @id @default(uuid())
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shiftId       String
  shift         Shift     @relation(fields: [shiftId], references: [id])
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())

  @@map("shift_assignments")
}

model Roster {
  id          String   @id @default(uuid())
  companyId   String
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shiftId     String
  shift       Shift    @relation(fields: [shiftId], references: [id])
  date        DateTime @db.Date
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@unique([employeeId, date])
  @@map("rosters")
}

model BreakRule {
  id              String           @id @default(uuid())
  companyId       String
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name            String
  durationMinutes Int
  isPaid          Boolean          @default(true)
  maxPerShift     Int              @default(1)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  shiftBreakRules ShiftBreakRule[]

  @@map("break_rules")
}

model ShiftBreakRule {
  id          String    @id @default(uuid())
  shiftId     String
  shift       Shift     @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  breakRuleId String
  breakRule   BreakRule @relation(fields: [breakRuleId], references: [id], onDelete: Cascade)

  @@unique([shiftId, breakRuleId])
  @@map("shift_break_rules")
}

model WeeklyOffRule {
  id          String                @id @default(uuid())
  companyId   String
  company     Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  days        String[]
  description String?
  isActive    Boolean               @default(true)
  createdAt   DateTime              @default(now())
  assignments WeeklyOffAssignment[]

  @@map("weekly_off_rules")
}

model WeeklyOffAssignment {
  id              String        @id @default(uuid())
  employeeId      String
  employee        Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  weeklyOffRuleId String
  weeklyOffRule   WeeklyOffRule @relation(fields: [weeklyOffRuleId], references: [id])
  effectiveFrom   DateTime
  effectiveTo     DateTime?
  createdAt       DateTime      @default(now())

  @@map("weekly_off_assignments")
}

// ============ 10. HOLIDAYS (3 models) ============

model HolidayCalendar {
  id          String            @id @default(uuid())
  companyId   String
  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  year        Int
  description String?
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  holidays    FestivalHoliday[]

  @@unique([companyId, year])
  @@map("holiday_calendars")
}

model FestivalHoliday {
  id          String                      @id @default(uuid())
  calendarId  String
  calendar    HolidayCalendar             @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  name        String
  date        DateTime                    @db.Date
  isMandatory Boolean                     @default(true)
  description String?
  createdAt   DateTime                    @default(now())
  assignments FestivalHolidayAssignment[]

  @@map("festival_holidays")
}

model FestivalHolidayAssignment {
  id         String          @id @default(uuid())
  holidayId  String
  holiday    FestivalHoliday @relation(fields: [holidayId], references: [id], onDelete: Cascade)
  employeeId String
  createdAt  DateTime        @default(now())

  @@map("festival_holiday_assignments")
}

// ============ 11. PAYROLL (6 models) ============

model SalaryComponent {
  id                  String                     @id @default(uuid())
  companyId           String
  company             Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name                String
  code                String
  type                String
  calculationType     String
  percentage          Decimal?                   @db.Decimal(5, 2)
  isTaxable           Boolean                    @default(true)
  isActive            Boolean                    @default(true)
  createdAt           DateTime                   @default(now())
  structureComponents SalaryStructureComponent[]

  @@unique([companyId, code])
  @@map("salary_components")
}

model EmployeeSalaryStructure {
  id            String                     @id @default(uuid())
  employeeId    String                     @unique
  employee      Employee                   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  ctc           Decimal                    @db.Decimal(12, 2)
  effectiveFrom DateTime
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  components    SalaryStructureComponent[]

  @@map("employee_salary_structures")
}

model SalaryStructureComponent {
  id          String                  @id @default(uuid())
  structureId String
  structure   EmployeeSalaryStructure @relation(fields: [structureId], references: [id], onDelete: Cascade)
  componentId String
  component   SalaryComponent         @relation(fields: [componentId], references: [id])
  amount      Decimal                 @db.Decimal(12, 2)

  @@unique([structureId, componentId])
  @@map("salary_structure_components")
}

model PayrollRun {
  id              String        @id @default(uuid())
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  month           Int
  year            Int
  status          String        @default("DRAFT")
  totalGross      Decimal       @default(0) @db.Decimal(14, 2)
  totalDeductions Decimal       @default(0) @db.Decimal(14, 2)
  totalNet        Decimal       @default(0) @db.Decimal(14, 2)
  processedBy     String?
  processedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  items           PayrollItem[]

  @@unique([companyId, month, year])
  @@map("payroll_runs")
}

model PayrollItem {
  id              String            @id @default(uuid())
  payrollRunId    String
  payrollRun      PayrollRun        @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee          @relation(fields: [employeeId], references: [id])
  grossSalary     Decimal           @db.Decimal(12, 2)
  totalDeductions Decimal           @db.Decimal(12, 2)
  netSalary       Decimal           @db.Decimal(12, 2)
  presentDays     Int
  absentDays      Int
  leaveDays       Int
  createdAt       DateTime          @default(now())
  salarySlip      SalarySlip?
  lineItems       PayslipLineItem[]

  @@map("payroll_items")
}

model PayslipLineItem {
  id            String      @id @default(uuid())
  payrollItemId String
  payrollItem   PayrollItem @relation(fields: [payrollItemId], references: [id], onDelete: Cascade)
  componentId   String?
  componentName String
  type          String      // EARNING | DEDUCTION
  amount        Decimal     @db.Decimal(12, 2)
  createdAt     DateTime    @default(now())

  @@index([payrollItemId])
  @@map("payslip_line_items")
}

model Loan {
  id              String    @id @default(uuid())
  employeeId      String
  employee        Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  principal       Decimal   @db.Decimal(12, 2)
  interestRate    Decimal   @default(0) @db.Decimal(5, 2)
  tenureMonths    Int
  emiAmount       Decimal   @db.Decimal(12, 2)
  startDate       DateTime
  endDate         DateTime?
  remainingAmount Decimal   @db.Decimal(12, 2)
  status          String    @default("ACTIVE") // ACTIVE, CLOSED
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([employeeId, status])
  @@index([companyId, status])
  @@map("loans")
}

model Reimbursement {
  id                 String    @id @default(uuid())
  employeeId         String
  employee           Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  companyId          String
  company            Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category           String
  amount             Decimal   @db.Decimal(12, 2)
  billDate           DateTime
  status             String    @default("PENDING") // PENDING, APPROVED, REJECTED, PAID
  approvedBy         String?
  approvedAt         DateTime?
  paidInPayrollRunId String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([employeeId, status])
  @@index([companyId, status])
  @@map("reimbursements")
}

model SalarySlip {
  id            String      @id @default(uuid())
  payrollItemId String      @unique
  payrollItem   PayrollItem @relation(fields: [payrollItemId], references: [id], onDelete: Cascade)
  slipNumber    String      @unique
  pdfUrl        String?
  generatedAt   DateTime    @default(now())

  @@map("salary_slips")
}

// ============ 12. DOCUMENTS (4 models) ============

model DocumentType {
  id          String             @id @default(uuid())
  companyId   String
  name        String
  isMandatory Boolean            @default(false)
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  documents   EmployeeDocument[]

  @@map("document_types")
}

model EmployeeDocument {
  id              String       @id @default(uuid())
  employeeId      String
  employee        Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  documentTypeId  String
  documentType    DocumentType @relation(fields: [documentTypeId], references: [id])
  fileName        String
  fileUrl         String
  publicId        String
  fileSize        Int?
  mimeType        String?
  format          String?
  status          String       @default("PENDING")
  verifiedBy      String?
  verifiedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // Aadhaar-specific fields
  aadhaarNumber       String?
  aadhaarVerified     Boolean  @default(false)
  uidaiTransactionId  String?
  otpVerifiedAt       DateTime?
  verificationMethod  String?  // "UIDAI_OTP", "DEMO", "MANUAL", "AUTO"

  @@map("employee_documents")
}

model AadhaarVerification {
  id                String   @id @default(uuid())
  employeeId        String
  companyId         String
  aadhaarNumber     String   // Masked: XXXX-XXXX-1234
  transactionId     String   @unique
  provider          String   // setu, signzy, karza, demo
  status            String   @default("OTP_SENT")  // OTP_SENT, VERIFIED, DEMO_VERIFIED, FAILED, EXPIRED
  aadhaarData       Json?
  attempts          Int      @default(0)
  maxAttempts       Int      @default(5)
  expiresAt         DateTime
  verifiedAt        DateTime?
  usedAt            DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([employeeId, status])
  @@index([transactionId])
  @@map("aadhaar_verifications")
}

model CertificateTemplate {
  id           String                @id @default(uuid())
  companyId    String
  name         String
  htmlTemplate String                @db.Text
  isActive     Boolean               @default(true)
  createdAt    DateTime              @default(now())
  certificates EmployeeCertificate[]

  @@map("certificate_templates")
}

model EmployeeCertificate {
  id                String              @id @default(uuid())
  employeeId        String
  employee          Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  templateId        String
  template          CertificateTemplate @relation(fields: [templateId], references: [id])
  certificateNumber String              @unique
  pdfUrl            String?
  issuedAt          DateTime            @default(now())
  issuedBy          String?

  @@map("employee_certificates")
}

// ============ 13. PROJECTS & CLIENTS (8 models) ============

model Client {
  id           String               @id @default(uuid())
  companyId    String
  company      Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId       String?              @unique
  user         User?                @relation(fields: [userId], references: [id])
  name         String
  email        String?
  phone        String?
  companyName  String?
  address      String?
  isActive     Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  projects     Project[]
  requirements ProjectRequirement[]

  @@map("clients")
}

model Project {
  id           String               @id @default(uuid())
  companyId    String
  company      Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clientId     String?
  client       Client?              @relation(fields: [clientId], references: [id])
  name         String
  description  String?
  status       ProjectStatus        @default(ACTIVE)
  startDate    DateTime?
  endDate      DateTime?
  budget       Decimal?             @db.Decimal(12, 2)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  members      ProjectMember[]
  modules      ProjectModule[]
  milestones   ProjectMilestone[]
  tasks        ProjectTask[]
  requirements ProjectRequirement[]
  comments     ProjectComment[]

  @@map("projects")
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

model ProjectMember {
  id         String   @id @default(uuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  role       String
  joinedAt   DateTime @default(now())

  @@unique([projectId, employeeId])
  @@map("project_members")
}

model ProjectModule {
  id          String        @id @default(uuid())
  projectId   String
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  description String?
  order       Int           @default(0)
  createdAt   DateTime      @default(now())
  tasks       ProjectTask[]

  @@map("project_modules")
}

model ProjectMilestone {
  id          String    @id @default(uuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  description String?
  dueDate     DateTime?
  completedAt DateTime?
  status      String    @default("PENDING")
  createdAt   DateTime  @default(now())

  @@map("project_milestones")
}

model ProjectTask {
  id             String         @id @default(uuid())
  projectId      String
  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  moduleId       String?
  module         ProjectModule? @relation(fields: [moduleId], references: [id])
  assigneeId     String?
  title          String
  description    String?
  status         String         @default("TODO")
  priority       String         @default("MEDIUM")
  estimatedHours Decimal?       @db.Decimal(6, 2)
  actualHours    Decimal?       @db.Decimal(6, 2)
  dueDate        DateTime?
  completedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@map("project_tasks")
}

model ProjectRequirement {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clientId    String?
  client      Client?  @relation(fields: [clientId], references: [id])
  title       String
  description String?
  status      String   @default("PENDING")
  priority    String   @default("MEDIUM")
  createdAt   DateTime @default(now())

  @@map("project_requirements")
}

model ProjectComment {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  content   String   @db.Text
  createdAt DateTime @default(now())

  @@map("project_comments")
}

// ============ 14. TASKS & PERFORMANCE (6 models) ============

model Task {
  id          String        @id @default(uuid())
  companyId   String
  employeeId  String
  employee    Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      String        @default("TODO")
  priority    String        @default("MEDIUM")
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  comments    TaskComment[]
  history     TaskHistory[]

  @@map("tasks")
}

model TaskComment {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  content   String   @db.Text
  createdAt DateTime @default(now())

  @@map("task_comments")
}

model TaskHistory {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  field     String
  oldValue  String?
  newValue  String?
  changedBy String?
  createdAt DateTime @default(now())

  @@map("task_history")
}

model PerformanceCycle {
  id        String              @id @default(uuid())
  companyId String
  name      String
  startDate DateTime
  endDate   DateTime
  status    String              @default("ACTIVE")
  createdAt DateTime            @default(now())
  reviews   PerformanceReview[]
  goals     Goal[]

  @@map("performance_cycles")
}

model PerformanceReview {
  id          String           @id @default(uuid())
  cycleId     String
  cycle       PerformanceCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  reviewerId  String?
  rating      Decimal?         @db.Decimal(3, 2)
  comments    String?          @db.Text
  status      String           @default("PENDING")
  submittedAt DateTime?
  createdAt   DateTime         @default(now())

  @@map("performance_reviews")
}

model Goal {
  id          String           @id @default(uuid())
  cycleId     String
  cycle       PerformanceCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  title       String
  description String?
  targetDate  DateTime?
  status      String           @default("ACTIVE")
  progress    Int              @default(0)
  createdAt   DateTime         @default(now())

  @@map("goals")
}

// ============ 15. APPROVALS (2 models) ============

model ApprovalWorkflow {
  id         String            @id @default(uuid())
  companyId  String
  name       String
  entityType String
  levels     Json
  isActive   Boolean           @default(true)
  createdAt  DateTime          @default(now())
  requests   ApprovalRequest[]

  @@map("approval_workflows")
}

model ApprovalRequest {
  id           String           @id @default(uuid())
  workflowId   String
  workflow     ApprovalWorkflow @relation(fields: [workflowId], references: [id])
  entityType   String
  entityId     String
  requestedBy  String
  currentLevel Int              @default(1)
  status       RequestStatus    @default(PENDING)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@map("approval_requests")
}

// ============ 16. EMERGENCY (1 model) ============

model EmergencyAttendance {
  id           String        @id @default(uuid())
  employeeId   String
  employee     Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date         DateTime      @db.Date
  checkInTime  DateTime?
  checkOutTime DateTime?
  reason       String
  status       RequestStatus @default(PENDING)
  approvedBy   String?
  approvedAt   DateTime?
  createdAt    DateTime      @default(now())

  @@map("emergency_attendance")
}

// ============ 17. ASSETS (2 models) ============

model Asset {
  id            String            @id @default(uuid())
  companyId     String
  company       Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name          String
  code          String
  category      String?
  description   String?
  purchaseDate  DateTime?
  purchasePrice Decimal?          @db.Decimal(12, 2)
  condition     String            @default("GOOD")
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())
  assignments   AssetAssignment[]

  @@unique([companyId, code])
  @@map("assets")
}

model AssetAssignment {
  id         String    @id @default(uuid())
  assetId    String
  asset      Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  assignedAt DateTime  @default(now())
  returnedAt DateTime?
  condition  String?
  remarks    String?

  @@map("asset_assignments")
}

// ============ 18. NOTIFICATIONS (3 models) ============

model NotificationTemplate {
  id        String   @id @default(uuid())
  companyId String?
  name      String
  type      String
  subject   String?
  body      String   @db.Text
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("notification_templates")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String    @db.Text
  type      String    @default("IN_APP")
  priority  String    @default("MEDIUM")
  isRead    Boolean   @default(false)
  readAt    DateTime?
  metadata  Json?
  createdAt DateTime  @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

model NotificationLog {
  id          String   @id @default(uuid())
  userId      String?
  type        String
  recipient   String
  subject     String?
  body        String?  @db.Text
  status      String
  errorReason String?
  createdAt   DateTime @default(now())

  @@map("notification_logs")
}

model ReportHistory {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId      String?
  type        String
  format      String   @default("CSV")
  fileUrl     String?
  fileName    String?
  status      String   @default("COMPLETED")
  filters     Json?
  errorReason String?
  createdAt   DateTime @default(now())

  @@index([companyId, type])
  @@map("report_histories")
}

// ============ 15. AI & ANALYTICS (2 models) ============

model AIInsight {
  id          String    @id @default(uuid())
  companyId   String?
  employeeId  String?
  userId      String?
  insightType String
  period      String?
  prompt      String?   @db.Text
  content     Json
  rawResponse String?   @db.Text
  model       String    @default("gemini-1.5-flash")
  tokensUsed  Int       @default(0)
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([companyId, insightType])
  @@index([employeeId, insightType])
  @@index([expiresAt])
  @@map("ai_insights")
}

model AIUsageLog {
  id               String   @id @default(uuid())
  companyId        String?
  userId           String?
  provider         String   @default("gemini")
  model            String   @default("gemini-1.5-flash")
  action           String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  latencyMs        Int      @default(0)
  status           String   @default("SUCCESS")
  errorMessage     String?
  createdAt        DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([provider, createdAt])
  @@map("ai_usage_logs")
}

model FaceRegistrationRequest {
  id                    String   @id @default(uuid())
  employeeId            String
  employee              Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  companyId             String

  // Pending data (not yet active)
  pendingPhotoUrl       String
  pendingPhotoPublicId  String?
  pendingEmbedding      String   // Encrypted
  livenessScore         String?

  // Approval
  status                String   @default("PENDING")  // PENDING, APPROVED, REJECTED
  requestedBy           String
  approvedBy            String?
  approvedAt            DateTime?
  rejectionReason       String?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([companyId, status])
  @@index([employeeId])
  @@map("face_registration_requests")
}



