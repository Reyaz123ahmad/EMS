# Production Environment Configuration Example
NODE_ENV=production
PORT=5000

# Database (PostgreSQL / Supabase / AWS RDS)
DATABASE_URL=postgresql://user:password@host:5432/ems_prod?schema=public

# Redis (Upstash / Redis Cloud)
REDIS_URL=redis://default:password@host:6379

# Authentication JWT
JWT_SECRET=super_secret_jwt_key_min_32_characters_long
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_min_32_characters_long
JWT_REFRESH_EXPIRES_IN=30d

# Frontend Domain
FRONTEND_URL=https://ems.yourdomain.com

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# SMTP Email Configuration
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key
FROM_EMAIL=no-reply@yourdomain.com
