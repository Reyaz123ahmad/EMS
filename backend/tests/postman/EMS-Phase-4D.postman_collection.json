{
  "info": {
    "name": "EMS Phase 4D - Platform Admin & Security API Collection",
    "_postman_id": "phase-4d-ems-collection-id",
    "description": "Full Postman collection for Phase 4D: Subscriptions, Settings, Advanced Security, Approvals, Assets, Emergency Attendance, and Queue Monitor APIs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api/v1" },
    { "key": "token", "value": "YOUR_SUPER_ADMIN_JWT_TOKEN" },
    { "key": "companyId", "value": "1432e74d-35ab-4f27-956a-4fcf11c821c9" },
    { "key": "planId", "value": "plan-uuid-placeholder" },
    { "key": "workflowId", "value": "workflow-uuid-placeholder" },
    { "key": "assetId", "value": "asset-uuid-placeholder" }
  ],
  "item": [
    {
      "name": "1. Subscriptions & Billing",
      "item": [
        {
          "name": "Get Subscription Plans",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/subscriptions/plans"
          }
        },
        {
          "name": "Get Current Subscription",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/subscriptions/current"
          }
        },
        {
          "name": "Create Razorpay Order",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"planId\": \"{{planId}}\",\n  \"billingCycle\": \"yearly\"\n}"
            },
            "url": "{{baseUrl}}/subscriptions/orders"
          }
        },
        {
          "name": "Verify Payment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"razorpayOrderId\": \"order_test_12345\",\n  \"razorpayPaymentId\": \"pay_test_12345\",\n  \"razorpaySignature\": \"sig_test_12345\",\n  \"planId\": \"{{planId}}\",\n  \"billingCycle\": \"yearly\"\n}"
            },
            "url": "{{baseUrl}}/subscriptions/verify"
          }
        },
        {
          "name": "Renew Subscription",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"planId\": \"{{planId}}\",\n  \"billingCycle\": \"monthly\"\n}"
            },
            "url": "{{baseUrl}}/subscriptions/renew"
          }
        },
        {
          "name": "Cancel Subscription",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Company restructuring\"\n}"
            },
            "url": "{{baseUrl}}/subscriptions/cancel"
          }
        },
        {
          "name": "Get Subscription History",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/subscriptions/history"
          }
        },
        {
          "name": "Get Subscription Stats",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/subscriptions/stats"
          }
        },
        {
          "name": "Check Expiry",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/subscriptions/check-expiry"
          }
        }
      ]
    },
