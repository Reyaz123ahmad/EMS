            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"channels\": { \"email\": true, \"sms\": false, \"push\": true, \"inApp\": true },\n  \"events\": { \"punchAlert\": true, \"leaveApproved\": true }\n}"
            },
            "url": "{{baseUrl}}/companies/{{companyId}}/settings/notifications"
          }
        },
        {
          "name": "Get General Settings",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/companies/{{companyId}}/settings/general"
          }
        },
        {
          "name": "Update General Settings",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
