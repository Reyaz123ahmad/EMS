            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"timezone\": \"Asia/Kolkata\",\n  \"currency\": \"INR\",\n  \"dateFormat\": \"YYYY-MM-DD\",\n  \"workWeekDays\": [\"MON\", \"TUE\", \"WED\", \"THU\", \"FRI\"]\n}"
            },
            "url": "{{baseUrl}}/companies/{{companyId}}/settings/general"
          }
        },
        {
          "name": "Reset Settings",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"settingType\": \"general\"\n}"
            },
            "url": "{{baseUrl}}/companies/{{companyId}}/settings/reset"
          }
        }
      ]
    },
