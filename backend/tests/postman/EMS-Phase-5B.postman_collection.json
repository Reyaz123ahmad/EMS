	"item": [
		{
			"name": "1. Custom Unique IDs",
			"item": [
				{
					"name": "List Companies by Code",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{superAdminToken}}", "type": "text" }
						],
						"url": {
							"raw": "{{baseUrl}}/companies?companyCode={{sampleCompanyCode}}",
							"host": ["{{baseUrl}}"],
							"path": ["companies"],
							"query": [{ "key": "companyCode", "value": "{{sampleCompanyCode}}" }]
						}
					}
				},
				{
					"name": "Get Company by Code or UUID",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{superAdminToken}}", "type": "text" }
						],
						"url": {
							"raw": "{{baseUrl}}/companies/{{sampleCompanyCode}}",
							"host": ["{{baseUrl}}"],
							"path": ["companies", "{{sampleCompanyCode}}"]
						}
					}
				},
				{
					"name": "Get Employee by Code or UUID",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{companyAdminToken}}", "type": "text" }
						],
						"url": {
							"raw": "{{baseUrl}}/employees/{{sampleEmployeeCode}}",
							"host": ["{{baseUrl}}"],
							"path": ["employees", "{{sampleEmployeeCode}}"]
						}
					}
				}
			]
		},
