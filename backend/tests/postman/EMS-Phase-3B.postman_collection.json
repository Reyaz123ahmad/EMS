{
  "info": {
    "name": "EMS Phase 3B - Card Attendance & Biometric Devices",
    "_postman_id": "ems-phase-3b-cards-devices-collection",
    "description": "Enterprise SaaS - Biometric QR Cards, PDF Badges, Tamper-proof Verification, Biometric Devices & Push Ingestion",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Biometric Cards",
      "item": [
        {
          "name": "Generate QR Card",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"employeeId\": \"{{test_employee_id}}\",\n  \"cardType\": \"QR\",\n  \"expiresAt\": \"2027-12-31T23:59:59.000Z\"\n}"
            },
            "url": { "raw": "{{base_url}}/biometric/cards/generate", "host": ["{{base_url}}"], "path": ["biometric", "cards", "generate"] }
          }
        },
        {
          "name": "Assign Physical Card (RFID)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"employeeId\": \"{{test_employee_id}}\",\n  \"cardNumber\": \"RFID-998811\",\n  \"cardType\": \"RFID\"\n}"
            },
            "url": { "raw": "{{base_url}}/biometric/cards/assign", "host": ["{{base_url}}"], "path": ["biometric", "cards", "assign"] }
          }
        },
        {
          "name": "List Cards",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "url": { "raw": "{{base_url}}/biometric/cards?page=1&limit=20", "host": ["{{base_url}}"], "path": ["biometric", "cards"], "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "20" }] }
          }
        },
        {
          "name": "Regenerate QR Code",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "url": { "raw": "{{base_url}}/biometric/cards/{{card_id}}/regenerate", "host": ["{{base_url}}"], "path": ["biometric", "cards", "{{card_id}}", "regenerate"] }
          }
        },
        {
          "name": "Deactivate Card",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Lost card requested by employee\"\n}"
            },
            "url": { "raw": "{{base_url}}/biometric/cards/{{card_id}}/deactivate", "host": ["{{base_url}}"], "path": ["biometric", "cards", "{{card_id}}", "deactivate"] }
          }
        },
        {
          "name": "Public Verify QR Code",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"qrData\": \"{{qr_data_string}}\"\n}"
            },
            "url": { "raw": "{{base_url}}/biometric/cards/verify-qr", "host": ["{{base_url}}"], "path": ["biometric", "cards", "verify-qr"] }
          }
        }
      ]
    },
    {
      "name": "2. Card QR Attendance Scan",
      "item": [
        {
          "name": "Card Scan Attendance Check-In",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"qrData\": \"{{qr_data_string}}\",\n  \"operation\": \"CHECK_IN\",\n  \"location\": {\n    \"lat\": 28.6139,\n    \"lng\": 77.2090,\n    \"accuracy\": 10,\n    \"source\": \"gps\"\n  },\n  \"deviceInfo\": {\n    \"isMockLocation\": false,\n    \"platform\": \"web\"\n  },\n  \"remarks\": \"Card scan check-in\"\n}"
            },
            "url": { "raw": "{{base_url}}/attendance/card-scan", "host": ["{{base_url}}"], "path": ["attendance", "card-scan"] }
          }
        }
      ]
    },
    {
      "name": "3. Biometric Hardware Devices",
      "item": [
        {
          "name": "Register Biometric Device",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Main Entrance Fingerprint Reader\",\n  \"serialNumber\": \"ZKT-BIO-2026-X1\",\n  \"deviceType\": \"FINGERPRINT\",\n  \"ipAddress\": \"192.168.1.150\",\n  \"port\": 4370\n}"
            },
            "url": { "raw": "{{base_url}}/biometric/devices", "host": ["{{base_url}}"], "path": ["biometric", "devices"] }
          }
        },
        {
          "name": "List Devices",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "url": { "raw": "{{base_url}}/biometric/devices?page=1&limit=20", "host": ["{{base_url}}"], "path": ["biometric", "devices"] }
          }
        },
        {
          "name": "Device Push Punch (Device Header Auth)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-api-key", "value": "{{device_api_key}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cardNumber\": \"EMP0001\",\n  \"punchType\": \"AUTO\",\n  \"verification\": \"FINGERPRINT\",\n  \"punchedAt\": \"2026-09-25T14:35:00.000Z\"\n}"
            },
            "url": { "raw": "{{base_url}}/biometric/push", "host": ["{{base_url}}"], "path": ["biometric", "push"] }
          }
        },
        {
          "name": "Get Punch Statistics",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "url": { "raw": "{{base_url}}/biometric/stats", "host": ["{{base_url}}"], "path": ["biometric", "stats"] }
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "base_url", "value": "http://localhost:5000/api/v1" },
    { "key": "jwt_token", "value": "" },
    { "key": "test_employee_id", "value": "" },
    { "key": "card_id", "value": "" },
    { "key": "device_api_key", "value": "" },
    { "key": "qr_data_string", "value": "" }
  ]
}
