{
  "info": {
    "_postman_id": "phase-4c-enterprise-operations-collection",
    "name": "EMS Phase 4C - Attendance, Leave, Payroll, Overtime, Shifts, Rosters & Holidays",
    "description": "Comprehensive API collection for HR operations covering Attendance Calendar & Overrides, Leave Entitlements & Approvals, Payroll Preview & Processing, Overtime Rules & Claims, Shift Assignments & Automated Rostering, and Holiday Calendars with full payloads.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api/v1" },
    { "key": "authToken", "value": "" },
    { "key": "companyId", "value": "" },
    { "key": "employeeId", "value": "" },
    { "key": "leaveTypeId", "value": "" },
    { "key": "leaveRequestId", "value": "" },
    { "key": "payrollRunId", "value": "" },
    { "key": "overtimeRuleId", "value": "" },
    { "key": "overtimeRequestId", "value": "" },
    { "key": "shiftId", "value": "" },
    { "key": "holidayCalendarId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Attendance Module",
      "item": [
        {
          "name": "Get Attendance Calendar View",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/attendance/calendar?companyId={{companyId}}&month=9&year=2026",
              "host": ["{{baseUrl}}"],
              "path": ["attendance", "calendar"],
              "query": [
                { "key": "companyId", "value": "{{companyId}}" },
                { "key": "month", "value": "9" },
                { "key": "year", "value": "2026" }
              ]
            }
          }
        },
        {
          "name": "Get Employee Attendance Summary",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/attendance/summary?companyId={{companyId}}&employeeId={{employeeId}}&month=9&year=2026",
              "host": ["{{baseUrl}}"],
              "path": ["attendance", "summary"],
              "query": [
                { "key": "companyId", "value": "{{companyId}}" },
                { "key": "employeeId", "value": "{{employeeId}}" },
                { "key": "month", "value": "9" },
                { "key": "year", "value": "2026" }
              ]
            }
          }
        },
        {
          "name": "Mark Manual Attendance (Override)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"companyId\": \"{{companyId}}\",\n  \"employeeId\": \"{{employeeId}}\",\n  \"date\": \"2026-09-24\",\n  \"checkIn\": \"09:00\",\n  \"checkOut\": \"18:00\",\n  \"status\": \"PRESENT\",\n  \"reason\": \"Manual system punch correction requested by management\",\n  \"markedBy\": \"{{employeeId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/attendance/manual",
              "host": ["{{baseUrl}}"],
              "path": ["attendance", "manual"]
            }
          }
        },
        {
          "name": "Bulk Mark Attendance",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"companyId\": \"{{companyId}}\",\n  \"employeeIds\": [\"{{employeeId}}\"],\n  \"date\": \"2026-09-23\",\n  \"status\": \"PRESENT\",\n  \"markedBy\": \"{{employeeId}}\",\n  \"reason\": \"Bulk team on-site authorization\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/attendance/bulk-mark",
              "host": ["{{baseUrl}}"],
              "path": ["attendance", "bulk-mark"]
            }
          }
        },
        {
          "name": "Get Attendance Exceptions",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/attendance/exceptions?companyId={{companyId}}&startDate=2026-09-01&endDate=2026-09-30",
              "host": ["{{baseUrl}}"],
              "path": ["attendance", "exceptions"],
              "query": [
                { "key": "companyId", "value": "{{companyId}}" },
                { "key": "startDate", "value": "2026-09-01" },
                { "key": "endDate", "value": "2026-09-30" }
              ]
            }
          }
        },
        {
          "name": "Update Attendance Policy",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"companyId\": \"{{companyId}}\",\n  \"policy\": {\n    \"workHoursPerDay\": 8,\n    \"gracePeriodMinutes\": 15,\n    \"halfDayThresholdHours\": 4,\n    \"overtimeThresholdMinutes\": 30\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/attendance/policy",
              "host": ["{{baseUrl}}"],
              "path": ["attendance", "policy"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Leave Management Module",
