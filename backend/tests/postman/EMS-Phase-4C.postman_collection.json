              "raw": "{\n  \"companyId\": \"{{companyId}}\",\n  \"name\": \"Weekend Rate\",\n  \"dayType\": \"WEEKEND\",\n  \"multiplier\": 2.0,\n  \"minMinutes\": 60,\n  \"maxDailyMinutes\": 480,\n  \"requiresApproval\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/overtime/rules",
              "host": ["{{baseUrl}}"],
              "path": ["overtime", "rules"]
