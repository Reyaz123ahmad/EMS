              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"companyId\": \"{{companyId}}\",\n  \"employeeId\": \"{{employeeId}}\",\n  \"date\": \"2026-09-24\",\n  \"minutes\": 120,\n  \"reason\": \"End-of-quarter financial audits and ledger reconciliation\"\n}"
            },
            "url": {
