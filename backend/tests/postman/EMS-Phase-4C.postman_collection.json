              ]
            }
          }
        }
      ]
    },
    {
      "name": "5. Shift & Roster Module",
      "item": [
        {
          "name": "Create Shift",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"companyId\": \"{{companyId}}\",\n  \"name\": \"Night Shift Operations\",\n  \"code\": \"NS\",\n  \"startTime\": \"22:00\",\n  \"endTime\": \"06:00\",\n  \"gracePeriod\": 15,\n  \"halfDayHours\": 4,\n  \"fullDayHours\": 8,\n  \"breakDuration\": 60,\n  \"isNightShift\": true,\n  \"description\": \"Graveyard shift overnight engineering support\"\n}"
