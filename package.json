{
  "name": "ems-fullstack",
  "version": "2.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "ems-mobile"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=backend",
